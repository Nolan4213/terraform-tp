*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform plugin/provider cache
**/.terraform/

# Variable files that may contain secrets
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc
